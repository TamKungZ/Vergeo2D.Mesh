<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;netstandard2.1</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Vergeo2D.Mesh</PackageId>
    <Version>1.1.1</Version>
    <Authors>TamKungZ_</Authors>
    <Product>Vergeo2D.Mesh</Product>
    <Description>2D mesh library with vertex, edge and face structures, texture/UV binding, and an optional deformer extension point, for editing textured 2D meshes as a base for 2D rigging tools.</Description>
    <Copyright>Copyright © 2026 TamKungZ_</Copyright>
    <PackageTags>2d;mesh;texture;uv;vertex;edge;face;rig;mesh-editor;deformer</PackageTags>
    <PackageReleaseNotes>Add netstandard2.1 support, improve API validation, and harden optional render backends when handling empty mesh buffers.</PackageReleaseNotes>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://dev.tamkungz.me/documentation/vergeo2d/</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/TamKungZ/Vergeo2D.Mesh</RepositoryUrl>
    <PackageIcon>icon.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="test/**/*.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.1'">
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
    <None Include="LICENSE" Pack="true" PackagePath="" />
    <None Include="assets/icon.png" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
